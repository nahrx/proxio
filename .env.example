# Salin ke .env lalu sesuaikan: cp .env.example .env
# port proxio (dipakai untuk host dan container sekaligus)
PORT_REWRITE=8080
PORT_FORWARD=8081

# host yang ditunnelkan lewat forward proxy (dipisah koma, * = semua)
FWD_HOSTS=example.com

DNS=1.1.1.1

# layanan solver Turnstile: POST {"sitekey","siteurl"} -> {"token","elapsed"}
# isi "off" untuk mematikan (api.js Cloudflare dibiarkan apa adanya)
TURNSTILE_SOLVER=http://192.168.50.212:8191/solve
